# FlowForge-AI environment — copy to .env and fill in. Never commit .env.

# Postgres (asyncpg driver). Matches infra/docker-compose.yml defaults.
DATABASE_URL=postgresql+asyncpg://flowforge:flowforge@localhost:5432/flowforge

# Redis — cache + background job queue.
REDIS_URL=redis://localhost:6379/0

# LLM provider selection: "ollama" (local dev, free) | "openai" (final validation only).
LLM_PROVIDER=ollama

# Ollama server (used when LLM_PROVIDER=ollama). Ollama runs on the HOST, not
# in compose, so containers must not use localhost — that resolves to the
# container itself. host.docker.internal is the host as seen from a container.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# OpenAI API key — only required when LLM_PROVIDER=openai. Keep out of the repo.
OPENAI_API_KEY=

# Embedding model name, resolved by the active provider (768-dim: EMBEDDING_DIM).
EMBEDDING_MODEL=nomic-embed-text

# Chat model used for triage. Phase 5's eval judge must be a different model (D5).
TRIAGE_MODEL=llama3.1:8b

# The eval judge (D5, D19 decision 1). A different model FAMILY, not just a
# different tag: two prompts on one model share its blind spots, which is what
# an independent score exists to catch. Config validation refuses a judge equal
# to TRIAGE_MODEL, so the stack will not start misconfigured.
#   ollama pull qwen2.5:7b
JUDGE_MODEL=qwen2.5:7b

# Structured logging (spec 06 section 3). "json" makes the trail queryable and
# carries run_id/org_id on every line; "text" is for tailing a container by eye.
LOG_LEVEL=INFO
LOG_FORMAT=json

# "dev" | "prod". prod tightens config checks and disables dev-only endpoints (Phase 7).
APP_ENV=dev

# Identity provider: "local" (offline issuer for dev/CI) | "auth0" (real tenant).
# The auth factory refuses "local" when APP_ENV=prod.
AUTH_PROVIDER=local

# Auth0 tenant settings — required only when AUTH_PROVIDER=auth0.
# AUTH0_DOMAIN is the tenant domain WITHOUT a scheme, e.g. flowforge.eu.auth0.com.
# AUTH0_AUDIENCE is the API identifier you register in Auth0; it becomes the
# token's `aud` claim and must match exactly.
# AUTH0_CLIENT_ID is the SPA application's client id — public, not a secret.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=flowforge-api
AUTH0_CLIENT_ID=

# Lifetime of a token minted by the local dev issuer.
DEV_TOKEN_TTL_SECONDS=3600

# How many times a run may be picked up before it is dead-lettered. A job that
# has already killed its worker twice will not succeed on the fifth try.
MAX_RUN_ATTEMPTS=3

# Document upload storage root (a docker volume in compose) and size cap.
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=20

# Chunking windows (tokens, approximate).
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
