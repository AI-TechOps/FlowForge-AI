#!/usr/bin/env bash
# Blocks direct pushes to main. All changes must land via pull request.
#
# One-time setup per clone (see CONTRIBUTING.md):
#   git config core.hooksPath .githooks
#
# git calls this hook with the remote name/url as args and feeds one line
# per ref being pushed on stdin: <local_ref> <local_sha> <remote_ref> <remote_sha>
set -u

PROTECTED_REF="refs/heads/main"

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "$PROTECTED_REF" ]; then
    echo "" >&2
    echo "✗ BLOCKED: direct push to 'main' is not allowed." >&2
    echo "" >&2
    echo "  Create a feature branch and open a pull request instead:" >&2
    echo "    git checkout -b feat/my-change" >&2
    echo "    git push -u origin feat/my-change" >&2
    echo "" >&2
    echo "  See CONTRIBUTING.md for the full workflow." >&2
    exit 1
  fi
done

exit 0
