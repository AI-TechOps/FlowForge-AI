# FlowForge-AI environment — copy to .env and fill in. Never commit .env.

# Postgres (asyncpg driver). Matches infra/docker-compose.yml defaults.
DATABASE_URL=postgresql+asyncpg://flowforge:flowforge@localhost:5432/flowforge

# Redis — cache + background job queue.
REDIS_URL=redis://localhost:6379/0

# LLM provider selection: "ollama" (local dev, free) | "openai" (final validation only).
LLM_PROVIDER=ollama

# Ollama server (used when LLM_PROVIDER=ollama). Ollama runs on the HOST, not
# in compose, so containers must not use localhost — that resolves to the
# container itself. host.docker.internal is the host as seen from a container.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# OpenAI API key — only required when LLM_PROVIDER=openai. Keep out of the repo.
OPENAI_API_KEY=

# Embedding model name, resolved by the active provider (768-dim: EMBEDDING_DIM).
EMBEDDING_MODEL=nomic-embed-text

# Chat model used for triage. Phase 5's eval judge must be a different model (D5).
TRIAGE_MODEL=llama3.1:8b

# "dev" | "prod". prod tightens config checks and disables dev-only endpoints (Phase 7).
APP_ENV=dev

# Document upload storage root (a docker volume in compose) and size cap.
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=20

# Chunking windows (tokens, approximate).
CHUNK_TARGET_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
